{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Second Skin pieces manifest",
  "type": "object",
  "required": [
    "version",
    "pieces"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "pieces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/piece"
      }
    }
  },
  "$defs": {
    "piece": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slot",
        "name",
        "year",
        "source",
        "locked",
        "assets",
        "fit",
        "pipeline"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ST[0-9A-Z/\\-]+$"
        },
        "slot": {
          "enum": [
            "top",
            "bottom",
            "feet",
            "full",
            "study"
          ]
        },
        "wear": {
          "description": "A study piece that also has a wearable GLB: the slot it is worn in once won",
          "enum": [
            "top",
            "bottom",
            "feet",
            "full"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "year": {
          "type": "object",
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "integer"
            },
            "to": {
              "type": "integer"
            }
          }
        },
        "source": {
          "type": "object",
          "required": [
            "imgSha"
          ],
          "additionalProperties": false,
          "properties": {
            "imgSha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          }
        },
        "locked": {
          "type": "boolean"
        },
        "assets": {
          "type": "object",
          "required": [
            "glb"
          ],
          "additionalProperties": false,
          "properties": {
            "glb": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "required": [
                    "path",
                    "kind",
                    "units",
                    "origin"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "path": {
                      "type": "string",
                      "pattern": "^assets/.+\\.glb$"
                    },
                    "kind": {
                      "enum": [
                        "scan",
                        "clo"
                      ]
                    },
                    "units": {
                      "enum": [
                        "norm",
                        "m"
                      ]
                    },
                    "origin": {
                      "enum": [
                        "bbox",
                        "avatar"
                      ]
                    }
                  }
                }
              ]
            },
            "splat": {
              "type": "object",
              "required": [
                "path"
              ],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^assets/splat/.+\\.sog$"
                }
              }
            },
            "clo": {
              "type": "object",
              "description": "A garment made in CLO 3D and exported already draped on the team avatar (D5: kind clo, origin avatar, metres). Worn on that avatar on outfit.html through OutfitRig; never fitted to the Stage dress form.",
              "required": ["path", "avatar", "kind", "units", "origin"],
              "additionalProperties": false,
              "properties": {
                "path": { "type": "string", "pattern": "^assets/clo/.+\\.glb$" },
                "avatar": { "type": "string", "pattern": "^assets/clo/.+\\.glb$" },
                "kind": { "const": "clo" },
                "units": { "const": "m" },
                "origin": { "const": "avatar" },
                "variants": {
                  "description": "The garment as worn together with other garments (ids in `over`), for layering, e.g. the blouse with its tail hidden below the trousers' waistband. OutfitRig shows the variant that names the most worn items, only when all of them are worn.",
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["over", "path"],
                    "additionalProperties": false,
                    "properties": {
                      "over": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                      "path": { "type": "string", "pattern": "^assets/clo/.+\\.glb$" }
                    }
                  }
                }
              }
            }
          }
        },
        "fit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "adjust": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "sleeveTo": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "split": {
              "description": "Body/sleeve boundary for fabric remix, as a fraction of the half width (default 0.5)",
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "hideStand": {
              "type": "boolean"
            }
          }
        },
        "pipeline": {
          "type": "object",
          "required": [
            "cutout"
          ],
          "additionalProperties": false,
          "properties": {
            "cutout": {
              "enum": [
                "segformer",
                "none",
                "vectorcraft"
              ]
            },
            "mesh": {
              "description": "Splat-to-garment settings for mockups/tools/garment.py (see docs/WEARABLE-PIPELINE.md)",
              "type": "object"
            }
          }
        },
        "details": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "find",
              "at",
              "quote",
              "en"
            ],
            "properties": {
              "find": {
                "type": "string",
                "minLength": 1
              },
              "at": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "minItems": 3,
                "maxItems": 3
              },
              "quote": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}

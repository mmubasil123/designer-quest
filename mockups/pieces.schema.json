{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Second Skin pieces manifest",
  "type": "object",
  "required": [
    "version",
    "pieces"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "pieces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/piece"
      }
    }
  },
  "$defs": {
    "piece": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slot",
        "name",
        "year",
        "source",
        "locked",
        "assets",
        "fit",
        "pipeline"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ST[0-9A-Z/\\-]+$"
        },
        "slot": {
          "enum": [
            "top",
            "bottom",
            "feet",
            "full",
            "study"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "year": {
          "type": "object",
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "integer"
            },
            "to": {
              "type": "integer"
            }
          }
        },
        "source": {
          "type": "object",
          "required": [
            "imgSha"
          ],
          "additionalProperties": false,
          "properties": {
            "imgSha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          }
        },
        "locked": {
          "type": "boolean"
        },
        "assets": {
          "type": "object",
          "required": [
            "glb"
          ],
          "additionalProperties": false,
          "properties": {
            "glb": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "required": [
                    "path",
                    "kind",
                    "units",
                    "origin"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "path": {
                      "type": "string",
                      "pattern": "^assets/.+\\.glb$"
                    },
                    "kind": {
                      "enum": [
                        "scan",
                        "clo"
                      ]
                    },
                    "units": {
                      "enum": [
                        "norm",
                        "m"
                      ]
                    },
                    "origin": {
                      "enum": [
                        "bbox",
                        "avatar"
                      ]
                    }
                  }
                }
              ]
            },
            "splat": {
              "type": "object",
              "required": [
                "path"
              ],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^assets/splat/.+\\.sog$"
                }
              }
            },
            "clo": {
              "type": "object",
              "description": "A7: CLO reconstruction of a study piece (D5: kind clo, origin avatar, metres). Shown on up-close.html beside the splat and worn on the avatar it was draped on; never fitted to the Stage dress form.",
              "required": [
                "path",
                "avatar",
                "kind",
                "units",
                "origin"
              ],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^assets/clo/.+\\.glb$"
                },
                "avatar": {
                  "type": "string",
                  "pattern": "^assets/clo/.+\\.glb$"
                },
                "kind": {
                  "const": "clo"
                },
                "units": {
                  "const": "m"
                },
                "origin": {
                  "const": "avatar"
                },
                "onScan": {
                  "description": "Where the garment's lowest and highest points sit on the splat, as fractions of the splat's bounding-box height (0 bottom, 1 top), read off up-close.html. Used only to overlay the reconstruction on the scan for Compare.",
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            }
          }
        },
        "fit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "adjust": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "sleeveTo": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "hideStand": {
              "type": "boolean"
            }
          }
        },
        "pipeline": {
          "type": "object",
          "required": [
            "cutout"
          ],
          "additionalProperties": false,
          "properties": {
            "cutout": {
              "enum": [
                "segformer",
                "none",
                "vectorcraft"
              ]
            }
          }
        },
        "details": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "find",
              "at",
              "quote",
              "en"
            ],
            "properties": {
              "find": {
                "type": "string",
                "minLength": 1
              },
              "at": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "minItems": 3,
                "maxItems": 3
              },
              "quote": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
